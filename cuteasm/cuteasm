# 主程序
def main(args):
    # 传递命令行参数给Options类
    if hasattr(args, 'input'):
        options = Options(args)
    else:
        options=Options()
    ref_d=options.reference
    # 检查输入的BAM文件是否可打开
    
    try:
        # 检查 bam1
        with pysam.AlignmentFile(options.bam1, "rb") as bam1:
            logging.info(f"Successfully opened BAM file: {options.bam1}")
    except Exception as e:
        logging.error(f"Failed to open BAM file: {options.bam1}. Error: {str(e)}")
        sys.exit(1)

    if options.bam2:
        try:
            # 检查 bam2（如果存在）
            with pysam.AlignmentFile(options.bam2, "rb") as bam2:
                logging.info(f"Successfully opened BAM file: {options.bam2}")
        except Exception as e:
            logging.error(f"Failed to open BAM file: {options.bam2}. Error: {str(e)}")
            sys.exit(1)
    if options.reference:
        try:
            # 检查 bam2（如果存在）
            with pysam.FastaFile(options.reference) as ref:
                logging.info(f"Successfully opened BAM file: {options.reference}")
        except Exception as e:
            logging.error(f"Failed to open BAM file: {options.reference}. Error: {str(e)}")
            sys.exit(1)
    if options.refbam:
        try:
            # 检查 bam2（如果存在）
            with pysam.AlignmentFile(options.refbam, "rb") as refbam:
                logging.info(f"Successfully opened BAM file: {options.refbam}")
        except Exception as e:
            logging.error(f"Failed to open BAM file: {options.refbam}. Error: {str(e)}")
            sys.exit(1)

    chromosomes = None
    # 获取染色体列表（从 bam1 中获取）
    with pysam.AlignmentFile(options.bam1, "rb") as bam1:
        chromosomes = bam1.references

    all_sv_candidates = []
    refsvcandidates=[]
    # 读取参考基因组的预输入候选
    if options.refbam:
        logging.info(f"Processing ref BAM file: {options.refbam}")
        # 使用进程池并行处理染色体
        pool_args = [(options.refbam, ref_d, chrom, options) for chrom in chromosomes]
        with Pool(processes=options.threads) as pool:
            results = pool.map(process_chromosome, pool_args)
        
        # 合并所有染色体的结果
        inter_sv_candidates, intra_candidates = merge_results(results)
        refsvcandidates = mergeAtrans_parts1(inter_sv_candidates, intra_candidates)
        logging.info(f"Loaded {len(refsvcandidates)} reference SV candidates from {options.refbam}")



    # 为每个BAM文件创建进程池
    for bam_file in [options.bam1, options.bam2] if options.bam2 else [options.bam1]:
        logging.info(f"Processing BAM file: {bam_file}")
        # 使用进程池并行处理染色体
        pool_args = [(bam_file, ref_d, chrom, options) for chrom in chromosomes]
        with Pool(processes=options.threads) as pool:
            results = pool.map(process_chromosome, pool_args)
        
        # 合并所有染色体的结果
        inter_sv_candidates, intra_candidates = merge_results(results)
        
        
        if options.refbam:
            with pysam.AlignmentFile(bam_file, "rb") as bam:
                sv_candidates = mergeAtrans_parts1(inter_sv_candidates, intra_candidates)
                sv_candidates = remove_fp(sv_candidates, refsvcandidates)
                sv_candidates = mergeAtrans_part2(sv_candidates, bam)
                all_sv_candidates.append(sv_candidates)
        else:
        # 打开BAM文件并合并Atrans
            with pysam.AlignmentFile(bam_file, "rb") as bam:
                sv_candidates = mergeAtrans(inter_sv_candidates, intra_candidates, bam)
                all_sv_candidates.append(sv_candidates)
    # 如果有多个BAM文件，进行SV配对
    if len(all_sv_candidates) > 1:
        sv_candidates1, sv_candidates2 = all_sv_candidates
        with pysam.AlignmentFile(options.bam1, "rb") as bam1, pysam.FastaFile(ref_d) as reference:
            can = pair_candidates(sv_candidates1, sv_candidates2, reference, bam1, options)
            write_final_vcf(can, bam1.references, bam1.lengths, reference, sys.argv, options)
    else:
        logging.warning("Only one BAM file processed, skipping pairing step.")
        with pysam.AlignmentFile(options.bam1, "rb") as bam1, pysam.FastaFile(ref_d) as reference:
            write_final_vcf(all_sv_candidates[0], bam1.references, bam1.lengths, reference, sys.argv, options)
    logging.info("SV分析完成。")
# 主入口
def run(argv):
    args = parseArgs(argv)
    setupLogging(args.work_dir,args.debug)
    starttime = time.time()
    main(args)
    logging.info("Finished in %0.2f seconds." % (time.time() - starttime))

if __name__ == '__main__':
    # run(sys.argv[1:])
    main([1])