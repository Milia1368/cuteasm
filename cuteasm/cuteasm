ins_num = 1
inv_num = 2
duptan_num = 3
dupint_num = 4
bnd_num = 5


# 定义处理单条染色体的函数
def process_chromosome(args):
    bam_path, ref_path, chromosome, options = args
    try:
        # 每个进程中打开文件
        reference = pysam.FastaFile(ref_path)
        bam = pysam.AlignmentFile(bam_path, "rb")
        
        # 初始化结果字典
        sv_candidates_inter = {svtype: [] for svtype in types_to_output}
        intra_candidates = {svtype: [] for svtype in ['DEL', 'INS']}
        
        # 调用分析函数
        bnd=analyze_alignment_file_coordsorted(bam, reference, chromosome, options, sv_candidates_inter, intra_candidates)
        

        bam.close()
        reference.close()
        
        return sv_candidates_inter, intra_candidates,bnd
    except Exception as e:
        logging.error(f"Error processing {chromosome} in {bam_path}: {e}")
        for line in traceback.format_exc().splitlines():
            logging.error(line)
        return None

# 定义合并结果的函数
from cluster import merge_bnd,cluster_bnd
def merge_results(results):
    merged_inter = {svtype: [] for svtype in types_to_output}
    merged_intra = {svtype: [] for svtype in ['DEL', 'INS']}
    bnd_sv=[]
    for res in results:
        if res is None:
            continue
        sv_candidates_inter, intra_candidates,bnd = res
        for svtype in types_to_output:
            merged_inter[svtype].extend(sv_candidates_inter.get(svtype, []))
        for svtype in ['DEL', 'INS']:
            merged_intra[svtype].extend(intra_candidates.get(svtype, []))
        bnd_sv.extend(bnd)
    #对正常的bnd聚类
    bndlist=merged_inter[types_to_output[bnd_num]]
    bndlist.extend(merge_bnd(bnd_sv))
    merged_inter[types_to_output[bnd_num]]=cluster_bnd(bndlist)
    return merged_inter, merged_intra
# 定义合并Atrans的函数
from realign import cluster_cut_paste,cluster_dupint
def mergeAtrans(inter_can, intra_can, bam, mode=0):
    gen = '1/0' if mode == 0 else '0/1'
    sv_candidates = []
 
    for svtype in types_to_output:
        if svtype == 'DEL':
            type_candidates =  intra_can[svtype]
            type_candidates.sort(key=lambda x: (x[1], x[2], x[3]))
            for can in type_candidates:
                sv_candidates.append(CandidateDeletion(can[1], can[2], can[3], [can[4]], gen))
        elif svtype == 'INS':
            type_candidates =  intra_can[svtype]
            type_candidates.sort(key=lambda x: (x[1], x[2], x[3]))
            for can in type_candidates:
                sv_candidates.append(CandidateInsertion(can[1], can[2], can[3], [can[4]], can[5], gen))
        elif svtype == 'BND':
            for can in inter_can[svtype]:
                # if can[0]==0:
                #     pass
                # elif can[0]==1:
                #     pass
                # else:#([5,ele1[al_chr_name],ele1[al_r_end],ele2[al_chr_name],ele2[al_r_start],readname,length,False,False]
                sv_candidates.append(CandidateBreakend(can[1], can[2], can[3], can[4], can[0], [can[5]], bam,can[-3],can[-2],can[-1], gen))
                
        elif svtype == 'INV':
            invs=remove_invs(inter_can[svtype])
            for can in invs:
                sv_candidates.append(CandidateInversion(can[1], can[2], can[3], can[4], [can[5]], bam, gen))
        elif svtype == 'DUP_TAN':
            for can in inter_can[svtype] :
                sv_candidates.append(CandidateDuplicationTandem(can[0], can[1], can[2], can[3], can[4], [can[5]], bam, gen))
        elif svtype == 'DUP_INT':
            # cluster_dupint(inter_can[svtype])
            cut_paset=[]
            dup_int=[]
            for can in inter_can[svtype]:
                if can[-1]:#[-1,del_can[1],del_can[2],del_can[3]+del_can[2],chrom,ins_start,ins_end,ins_flag,readname,True]
                    cut_paset.append(can)
                    
                else:#[-1,chrom,ins_start,ins_end,ins_flag,qs,len,readname,1,'pari',False]
                    dup_int.append(can)
                    
            if len(cut_paset)>0:
                cut_paset=cluster_cut_paste(cut_paset)
                for can in cut_paset:
                    sv_candidates.append(CandidateDuplicationInterspersed(can[1],can[2],can[3],can[4],can[5],can[6],[can[8]],bam,True,gen))
            if len(dup_int)>0:
                dup_int=cluster_dupint(dup_int)
                for can in dup_int:
                    sv_candidates.append(CandidateDuplicationInterspersed(can[1], can[2], can[3], can[1],can[5], can[5]+can[6], [can[7]], bam,False, gen,can[8]))
    return sv_candidates
def mergeAtrans_parts1(inter_can, intra_can):
    gen = '1/0' 
    sv_candidates = {svtype: [] for svtype in types_to_output}
    for svtype in types_to_output:
        if svtype == 'DEL':
            type_candidates = intra_can[svtype]
            type_candidates.sort(key=lambda x: (x[1], x[2], x[3]))
            sv_candidates[svtype].extend(type_candidates)
        elif svtype == 'INS':
            type_candidates =intra_can[svtype]
            type_candidates.sort(key=lambda x: (x[1], x[2], x[3]))
            sv_candidates[svtype].extend(type_candidates)
        elif svtype == 'BND':
            sv_candidates[svtype].extend(inter_can[svtype])
        elif svtype == 'INV':
            sv_candidates[svtype].extend(remove_invs(inter_can[svtype]))
        elif svtype == 'DUP_TAN':
            sv_candidates[svtype].extend(inter_can[svtype])
        elif svtype == 'DUP_INT':
            sv_candidates[svtype].extend(inter_can[svtype])
    return sv_candidates
